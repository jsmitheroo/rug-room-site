{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "WORKER_NAME",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rugroom",
      "database_id": "DATABASE_ID"
    }
  ]
}
